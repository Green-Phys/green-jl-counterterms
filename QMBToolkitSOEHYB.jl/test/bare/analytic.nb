               RowBox[{"tau3", ",", "0", ",", "Beta"}], "}"}]}], "}"}]}], 
           "*)"}], 
          RowBox[{"symbolicIterators", "=", 
           RowBox[{"Reverse", "[", "iteratorList", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"currentExpr", "=", "cleanIntegrand"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"singleIterator", "=", 
              RowBox[{"symbolicIterators", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{"Integrate", " ", "ONE", " ", "variable"}], "*)"}], 
             RowBox[{"currentExpr", "=", 
              RowBox[{"Integrate", "[", 
               RowBox[{"currentExpr", ",", "singleIterator", ",", 
                RowBox[{"GenerateConditions", "->", "False"}]}], "]"}]}], ";",
              "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
              "Simplify", " ", "result", " ", "immediately", " ", "using", " ",
                "original", " ", "assumptions"}], "*)"}], 
             RowBox[{"currentExpr", "=", 
              RowBox[{"Simplify", "[", 
               RowBox[{"currentExpr", ",", 
                RowBox[{"Assumptions", "->", "assumptionsList"}]}], "]"}]}], 
             ";"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"Length", "[", "symbolicIterators", "]"}]}], "}"}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"result", "=", "currentExpr"}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"numResult", "=", 
           RowBox[{"N", "[", 
            RowBox[{"result", ",", "16"}], "]"}]}], ";"}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
            RowBox[{"--", 
             RowBox[{"-", "NUMERICAL"}]}], " ", 
            RowBox[{"METHOD", "--"}]}], "-"}], "*)"}], 
         RowBox[{
          RowBox[{"result", "=", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{"cleanIntegrand", ",", 
             RowBox[{"Evaluate", "[", 
              RowBox[{"Sequence", "@@", "iteratorList"}], "]"}], ",", 
             RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}], ",", 
             RowBox[{"AccuracyGoal", "->", "18"}], ",", 
             RowBox[{"PrecisionGoal", "->", "18"}], ",", 
             RowBox[{"WorkingPrecision", "->", "32"}], ",", 
             RowBox[{"MaxPoints", "->", "200000"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"numResult", "=", 
           RowBox[{"N", "[", 
            RowBox[{"result", ",", "16"}], "]"}]}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "numResult", "]"}], ";"}]}], "]"}]}], 
