{
  "permissions": {
    "allow": [
      "Bash(julia:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-julia.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
