Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Robust", " ", 
    RowBox[{"Green", "'"}], "s", " ", "Function", " ", "Loop"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"CalculateGreensFunctionLoop", "[", 
      RowBox[{"timePointsIn_", ",", "diagramsIn_", ",", "ZTotalIn_", ",", 
       RowBox[{"useSymbolicIn_", ":", "False"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "results", ",", "tVal", ",", "numeratorSum", ",", "validDiagrams", ",",
          "i"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{"Sanitize", ":", 
         RowBox[{
          RowBox[{"Remove", " ", "any", " ", "Nulls", " ", "or", " ", "non"}],
           "-", 
          RowBox[{"list", " ", "elements", " ", "from", " ", "input"}]}]}], 
        "*)"}], 
       RowBox[{
        RowBox[{"validDiagrams", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"diagramsIn", ",", "ListQ"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Starting Green's Function Calculation over \>\"", ",", 
          RowBox[{"Length", "[", "timePointsIn", "]"}], 
          ",", "\"\< time points...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"results", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"tVal", "=", 
             RowBox[{"timePointsIn", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Use", " ", "Map", " ", "and", " ", "Total", " ", "for", " ", 
              "explicit", " ", "summation"}], "*)"}], 
            RowBox[{"numeratorSum", "=", 
             RowBox[{"Total", "[", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"CalculateNumeratorG", "[", 
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], ",", "tVal", ",", 
                   "useSymbolicIn"}], "]"}], "&"}], ",", "validDiagrams"}], 
               "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Return", " ", "G", 
              RowBox[{"(", "t", ")"}]}], "*)"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "*", "numeratorSum"}], ")"}], "/", 
             "ZTotalIn"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "timePointsIn", "]"}]}], "}"}]}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "results", "]"}], ";"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Robust", " ", "Numerator", " ", "Calculator"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"CalculateNumeratorG", "[", 
      RowBox[{
      "pairs_List", ",", "prefactorSign_", ",", "annihilationOpIndex_", ",", 
       "tValue_", ",", 
       RowBox[{"useSymbolic_", ":", "False"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "nPairs", ",", "maxTauIndex", ",", "tauVars", ",", "integrandTotal", ",",
          "calcIntegrandForConfig", ",", "cleanIntegrand", ",", "result", ",",
          "lowerVars", ",", "upperVars", ",", "lowerIterators", ",", 
         "upperIterators", ",", "fullIterators", ",", "numResult", ",", 
         "currentExpr", ",", "singleIterator", ",", "assumptionsList", ",", 
         "getTauSym", ",", "annihilationSymbol", ",", "allSwaps"}], "}"}], ",", 
       RowBox[{
        RowBox[{"nPairs", "=", 
         RowBox[{"Length", "[", "pairs", "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"maxTauIndex", "=", 
         RowBox[{
          RowBox[{"2", "*", "nPairs"}], "+", "2"}]}], ";", 
        "\[IndentingNewLine]", 
